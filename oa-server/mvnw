#!/bin/sh
# Maven Wrapper（无需预装 Maven，首次执行自动下载 Maven 3.9.9）
BASE_DIR=$(cd "$(dirname "$0")" && pwd)
JAR="$BASE_DIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
if [ ! -f "$JAR" ]; then
  echo "首次运行，正在下载 Maven Wrapper ..."
  curl -fsSL -o "$JAR" "$WRAPPER_URL" || { echo "下载失败，请检查网络"; exit 1; }
fi
exec java -cp "$JAR" org.apache.maven.wrapper.MavenWrapperMain "$@"
